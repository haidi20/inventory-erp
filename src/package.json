{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --config vitest.config.ts",
        "test:coverage": "vitest run --config vitest.config.ts --coverage --coverage.reporter=json-summary --coverage.reporter=text",
        "e2e": "playwright test --project=chromium",
        "e2e:report": "playwright test --project=chromium",
        "e2e:remember-me": "playwright test modules/Core/Identity/tests/presentation/views/login.view.spec.ts --project=chromium -g \"sesi login remember bertahan setelah browser di-restart\" --reporter=junit",
        "e2e:ci": "playwright test modules/Core/Organization/tests/api-environment-mode.real-data.view.spec.ts modules/Operational/Inventory/tests/presentation/views/inventory.real-data.view.spec.ts modules/Operational/Inventory/tests/presentation/views/inventory-real-data.view.spec.ts modules/Operational/Procurement/tests/presentations/purchase_order_form.real-data.view.spec.ts --project=chromium",
        "ci:coverage:vitest": "node ../scripts/check-vitest-coverage.mjs coverage/coverage-summary.json 0.5",
        "ci:coverage:playwright": "node ../scripts/check-playwright-coverage.mjs test-results/junit.xml 95",
        "test:e2e": "e2e run"
    },
    "devDependencies": {
        "@e2e-dev/web": "^0.14.0",
        "@inertiajs/core": "^3.0.3",
        "@inertiajs/vue3": "^3.0.3",
        "@openrouter/ai-sdk-provider": "^3.1.0",
        "@playwright/test": "^1.59.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/lodash": "^4.17.24",
        "@types/node": "^25.6.0",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vitest/coverage-v8": "^4.1.4",
        "@vue/test-utils": "^2.4.6",
        "@vueuse/core": "^14.2.1",
        "ai": "^7.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "e2e": "^0.19.0",
        "jsdom": "^27.0.0",
        "laravel-vite-plugin": "^2.0.0",
        "lodash": "^4.18.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "vite": "^7.0.7",
        "vitest": "^4.0.7",
        "vue": "^3.5.32",
        "ziggy-js": "^2.6.2"
    },
    "dependencies": {
        "alpinejs": "^3.15.11",
        "chart.js": "^4.5.1",
        "laravel-echo": "^2.5.0",
        "pinia": "^3.0.4",
        "pusher-js": "^8.6.0",
        "sweetalert2": "^11.26.24",
        "vue-select": "^4.0.0-beta.6",
        "zod": "^4.6.5"
    }
}
