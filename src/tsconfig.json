{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "preserve",
        "isolatedModules": true,
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["vite/client", "node", "vitest/globals"],
        "paths": {
            "@/*": ["./resources/*"],
            "@modules/*": ["./modules/*"]
        }
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.d.ts",
        "resources/js/**/*.vue",
        "resources/views/**/*.ts",
        "modules/**/*.ts",
        "modules/**/*.d.ts",
        "modules/**/*.vue"
    ],
    "exclude": [
        "node_modules",
        "public/build",
        "vendor"
    ]
}
