COMPOSE_PROJECT_NAME=inventory

# Global
TZ=Asia/Makassar

# MySQL Dev (port tinggi agar tidak bentrok dengan Laragon)
MYSQL_DEV_PORT=13306
MYSQL_DEV_DATABASE=app_db_dev

# MySQL Main
MYSQL_MAIN_PORT=13307
MYSQL_MAIN_DATABASE=app_db_main

# MySQL Shared credentials
MYSQL_USER=klinik
MYSQL_PASSWORD=klinikpassword
MYSQL_ROOT_PASSWORD=rootpassword

# phpMyAdmin
PHPMYADMIN_PORT=8080

# Redis
REDIS_PASSWORD=redispass
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=klinik-storage

# App URL
APP_URL_DEV=http://localhost:8088
APP_URL_MAIN=http://localhost:8089

# Nginx
NGINX_DEV_PORT=8088
NGINX_MAIN_PORT=8089

# Jenkins
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=qwerty123
JENKINS_PORT=8081
JENKINS_AGENT_PORT=50010
JENKINS_DEV_BRANCH=dev
JENKINS_PROD_BRANCH=main